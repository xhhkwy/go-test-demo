    {"id":"redis-noauth","source":"banner","pattern":"^-NOAUTH Authentication required\\.(?:\\r?\\n)?$","protocol":"Redis","product":"Redis","version_group":0,"priority":100,"confidence":0.7},
    {"id":"ftp-proftpd","source":"ftp","pattern":"(?i)^220[- ].*?\\bProFTPD(?:[ \\t]+([0-9][0-9A-Za-z._+-]*))?\\b","protocol":"FTP","product":"ProFTPD","version_group":1,"priority":100,"confidence":0.9},
    {"id":"ssh-generic","source":"ssh","pattern":"^SSH-(?:2\\.0|1\\.99|1\\.5)-[^ \\t]+(?:[ \\t].*)?$","protocol":"SSH","product":"","version_group":0,"priority":0,"confidence":0.6},
    {"id":"http-generic","source":"http_status","pattern":"^HTTP/","protocol":"HTTP","product":"","version_group":0,"priority":0,"confidence":0.6},
